{
  "name": "sentinelgrc",
  "version": "1.0.0",
  "description": "SentinelGRC \u2013 SAP GRC Security Platform on SAP BTP",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.13.0",
    "axios": "^1.17.0",
    "exceljs": "^4.4.0",
    "express": "^4",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "ui5-middleware-simpleproxy": "^3.8.0"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch --profile hybrid",
    "build": "cds build --production",
    "test": "node --check srv/handlers/security-handler.js && node --check srv/handlers/s4-connector.js && node --check srv/handlers/sod-engine.js && node --check srv/handlers/compliance-engine.js && node --check srv/handlers/scheduler.js && node --check srv/handlers/report-generator.js && node --check srv/handlers/security-notes-catalog.js && node --check srv/lib/credential-store.js && node --check srv/lib/ai-core.js && node --check srv/handlers/copilot.js"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "[hybrid]": {
          "kind": "xsuaa"
        },
        "[production]": {
          "kind": "xsuaa"
        },
        "[development]": {
          "kind": "mocked",
          "users": {
            "motaz.boubaker@aymax.fr": {
              "roles": [
                "SecurityAnalyst"
              ]
            }
          }
        }
      },
      "db": {
        "[production]": {
          "kind": "hana"
        },
        "[hybrid]": {
          "kind": "hana-cloud"
        }
      },
      "RD1_MO": {
        "kind": "odata",
        "credentials": {
          "destination": "RD1_MO"
        }
      }
    }
  }
}