<mvc:View
    controllerName="sentinel.security.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <tnt:ToolPage id="toolPage">

        <!-- ── Shell Header ── -->
        <tnt:header>
            <tnt:ToolHeader>
                <Button icon="sap-icon://menu2" type="Transparent" press=".onSideNavToggle" tooltip="Toggle Navigation"/>
                <core:Icon src="sap-icon://shield" size="1.4rem" color="Contrast" class="sapUiSmallMarginBegin"/>
                <Title text="SentinelGRC" level="H4" class="sapUiSmallMarginBegin"/>
                <Text text=" · SAP GRC Security Platform" wrapping="false"/>
                <ToolbarSpacer/>

                <!-- System Selector -->
                <Label text="System:" class="sapUiSmallMarginEnd" design="Bold"/>
<Select id="systemSelect" change=".onSystemChange" width="180px" selectedKey="RD1">
                    <items>
                        <core:Item key="RD1" text="RD1 · Development (MO)"/>
                        <core:Item key="QAS" text="QAS · Quality"/>
                        <core:Item key="PRD" text="PRD · Production"/>
                    </items>
                </Select>

                <!-- Connection status -->
                <ObjectStatus
                    id="connectionStatus"
                    text="RD1 · Connected"
                    state="Success"
                    icon="sap-icon://connected"
                    class="sapUiSmallMarginBegin sapUiSmallMarginEnd"/>

                <!-- Co-pilot button -->
                <Button
                    text="Co-pilot"
                    icon="sap-icon://ai"
                    type="Emphasized"
                    press=".onOpenCopilot"
                    class="sapUiSmallMarginEnd"/>

                <!-- Theme toggle (sun/moon pill) -->
                <core:HTML content="&lt;div id=&quot;sentinelThemePill&quot; class=&quot;sentinelThemePill&quot; role=&quot;button&quot; tabindex=&quot;0&quot; title=&quot;Toggle light / dark mode&quot;&gt;&lt;span class=&quot;sentinelThemePillIcon sentinelThemePillSun&quot;&gt;☀&lt;/span&gt;&lt;span class=&quot;sentinelThemePillIcon sentinelThemePillMoon&quot;&gt;☾&lt;/span&gt;&lt;span class=&quot;sentinelThemePillKnob&quot;&gt;&lt;/span&gt;&lt;/div&gt;"/>
                <!-- Notifications -->
                <Button id="notifBellBtn" icon="sap-icon://bell" type="Transparent" press=".onNotifications" tooltip="Notifications"/>

                <!-- Profile Avatar -->
                <Avatar
                    id="profileAvatar"
                    initials="MB"
                    displaySize="XS"
                    backgroundColor="Accent6"
                    press=".onProfilePress"
                    class="sapUiSmallMarginBegin"
                    tooltip="Motaz Belleh Boubaker · Basis Admin"/>
            </tnt:ToolHeader>
        </tnt:header>

        <!-- ── Side Navigation ── -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" itemSelect=".onNavItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem key="overview"    text="Overview"      icon="sap-icon://home"/>
                    <tnt:NavigationListItem key="violations"  text="Violations"    icon="sap-icon://alert" visible="{appState>/isAnalyst}"/>
                    <tnt:NavigationListItem key="users"       text="Users and Risk" icon="sap-icon://group" visible="{appState>/isAnalyst}"/>
                    <tnt:NavigationListItem key="critical"    text="Critical Roles" icon="sap-icon://warning2" visible="{appState>/isAnalyst}"/>
                    <tnt:NavigationListItem key="compliance"  text="Compliance"    icon="sap-icon://checklist" visible="{appState>/isAnalyst}"/>
                    <tnt:NavigationListItem key="rules"       text="SoD Rules"              icon="sap-icon://list" visible="{appState>/isAnalyst}"/>
                    <tnt:NavigationListItem key="scans"       text="Scan History"           icon="sap-icon://electrocardiogram"/>
                    <tnt:NavigationListItem key="remediation" text="Remediation Calendar"   icon="sap-icon://appointment-2"/>
                    <tnt:NavigationListItem key="alerts"      text="Alerts"                 icon="sap-icon://bell" visible="{appState>/isAnalyst}"/>
                    <tnt:NavigationListItem key="systemMonitor" text="System Monitor"       icon="sap-icon://sys-monitor"/>
                    <tnt:NavigationListItem key="settings"    text="Settings"               icon="sap-icon://settings" visible="{appState>/isAnalyst}"/>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <!-- ── Main Content ── -->
        <tnt:mainContents>
            <NavContainer id="appPages"/>
        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>
