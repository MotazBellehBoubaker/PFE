<mvc:View
    controllerName="sentinel.security.controller.Violations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="SoD Violations" level="H4"/>
                </contentLeft>
                <contentRight>
                    <Button text="Export CSV" icon="sap-icon://download" press=".onExportCSV"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- KPI tiles -->
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile header="Total Violations" subheader="This scan"         frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><NumericContent value="{vioKpi>/total}"  valueColor="Neutral"  withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="High Severity"    subheader="Critical exposure" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><NumericContent value="{vioKpi>/high}"   valueColor="Error"    withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Medium Severity"  subheader="Elevated risk"     frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><NumericContent value="{vioKpi>/medium}" valueColor="Critical" withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Low Severity"     subheader="Watchlist"         frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><NumericContent value="{vioKpi>/low}"    valueColor="Good"     withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Open"             subheader="Awaiting action"   frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><NumericContent value="{vioKpi>/open}"   valueColor="Critical" withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Newest Detected"  subheader="{vioKpi>/newestSub}" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><Text text="{vioKpi>/newestTime}" class="sentinelMono"/></content></TileContent></tileContent>
                    </GenericTile>
                </HBox>
                <!-- Search + Filters -->
                <Toolbar class="sapUiSmallMarginBottom">
                    <SearchField
                        id="violationSearch"
                        placeholder="Search users, roles, risks..."
                        width="280px"
                        search=".onSearch"
                        liveChange=".onSearch"/>
                    <ToolbarSpacer/>
                    <Label text="Severity:"/>
                    <Select id="severitySelect" change=".onSeverityFilterChange">
                        <items>
                            <core:Item key="All"    text="All Severities"/>
                            <core:Item key="High"   text="High"/>
                            <core:Item key="Medium" text="Medium"/>
                            <core:Item key="Low"    text="Low"/>
                        </items>
                    </Select>
                    <Label text="Status:" class="sapUiSmallMarginBegin"/>
                    <Select id="statusSelect" change=".onStatusFilterChange">
                        <items>
                            <core:Item key="All"          text="All Statuses"/>
                            <core:Item key="Open"         text="Open"/>
                            <core:Item key="Acknowledged" text="Acknowledged"/>
                            <core:Item key="Resolved"     text="Resolved"/>
                        </items>
                    </Select>
                </Toolbar>

                <!-- Violations Table + Detail side by side -->
                <HBox width="100%" alignItems="Stretch" renderType="Bare">
                <Panel>
                    <layoutData>
                        <FlexItemData growFactor="3" baseSize="0" shrinkFactor="1"/>
                    </layoutData>
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Violations" level="H5"/>
                            <ToolbarSpacer/>
                            <Label text="Scan:"/>
                            <Select
                                id="scanSelector"
                                width="280px"
                                change=".onScanChange"
                                items="{
                                    path: 'detail>/scans',
                                    templateShareable: false
                                }">
                                <core:Item
                                    xmlns:core="sap.ui.core"
                                    key="{detail>ID}"
                                    text="{detail>text}"/>
                            </Select>
                            <ToolbarSpacer/>
                            <Text text="{= ${detail>/totalCount} + ' items'}"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table
                            id="violationsTable"
                            items="{
                                path: 'sentinelgrc>/Violations',
                                parameters: {
                                    $orderby: 'detectedAt desc'
                                }
                            }"
                            mode="SingleSelectMaster"
                            selectionChange=".onViolationSelect"
                            growing="true"
                            growingThreshold="15"
                            sticky="ColumnHeaders"
                            updateFinished=".onTableUpdateFinished">
                            <columns>
                                <Column width="7rem">  <Text text="Severity"/>          </Column>
                                <Column width="10rem"> <Text text="User"/>              </Column>
                                <Column>               <Text text="Conflicting Roles"/> </Column>
                                <Column width="8rem">  <Text text="Status"/>            </Column>
                                <Column width="12rem"> <Text text="Detected"/>          </Column>
                            </columns>
                            <items>
                                <ColumnListItem
                                    highlight="{path: 'sentinelgrc>severity', formatter: '.formatter.rowHighlight'}"
                                    type="Active">
                                    <cells>
                                        <ObjectStatus
                                            text="{sentinelgrc>severity}"
                                            state="{path: 'sentinelgrc>severity', formatter: '.formatter.severityState'}"
                                            icon="{path: 'sentinelgrc>severity', formatter: '.formatter.severityIcon'}"/>
                                        <ObjectIdentifier
                                            title="{sentinelgrc>userName}"
                                            text="{sentinelgrc>userId}"/>
                                        <HBox alignItems="Center">
                                            <Text text="{sentinelgrc>roleA}" class="sentinelMono sentinelChip"/>
                                            <core:Icon src="sap-icon://arrow-right" class="sapUiSmallMarginBeginEnd"/>
                                            <Text text="{sentinelgrc>roleB}" class="sentinelMono sentinelChip"/>
                                        </HBox>
                                        <ObjectStatus
                                            text="{sentinelgrc>status}"
                                            state="{path: 'sentinelgrc>status', formatter: '.formatter.violationStatusState'}"/>
                                        <Text text="{path: 'sentinelgrc>detectedAt', formatter: '.formatter.formatDate'}" class="sentinelMono"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

                <!-- Detail Panel (right side) -->
                <Panel
                    id="detailPanel"
                    visible="{= !!${detail>/selectedViolation} }"
                    class="sapUiSmallMarginBegin">
                    <layoutData>
                        <FlexItemData growFactor="2" baseSize="0" shrinkFactor="1"/>
                    </layoutData>
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{detail>/selectedViolation/ID}" level="H5" class="sentinelMono"/>
                            <ToolbarSpacer/>
                            <ObjectStatus
                                text="{detail>/selectedViolation/severity}"
                                state="{path: 'detail>/selectedViolation/severity', formatter: '.formatter.severityState'}"/>
                            <Button
                                icon="sap-icon://decline"
                                type="Transparent"
                                tooltip="Close details"
                                press=".onCloseDetail"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <Title text="{detail>/selectedViolation/risk}" level="H5" class="sapUiSmallMarginBottom"/>

                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="User:" width="100px"/>
                                <Link text="{detail>/selectedViolation/userName}" press=".onNavigateToUser"/>
                                <Text text=" ({detail>/selectedViolation/userId})" class="sentinelMono"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Role A:" width="100px"/>
                                <Text text="{detail>/selectedViolation/roleA}" class="sentinelMono sentinelChip"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Role B:" width="100px"/>
                                <Text text="{detail>/selectedViolation/roleB}" class="sentinelMono sentinelChip"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Detected:" width="100px"/>
                                <Text text="{detail>/selectedViolation/detectedAt}" class="sentinelMono"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Scan:" width="100px"/>
                                <Text text="{detail>/selectedViolation/scanId}" class="sentinelMono"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Status:" width="100px"/>
                                <ObjectStatus
                                    text="{detail>/selectedViolation/status}"
                                    state="{path: 'detail>/selectedViolation/status', formatter: '.formatter.violationStatusState'}"/>
                            </HBox>

                            <!-- Actions -->
                            <HBox class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                                <Button text="Acknowledge"          type="Emphasized"  press=".onAcknowledge"           class="sapUiSmallMarginEnd"/>
                                <Button text="Open Ticket"                             press=".onOpenTicket"             class="sapUiSmallMarginEnd"/>
                                <Button text="Schedule Remediation" icon="sap-icon://appointment-2" press=".onScheduleRemediation" class="sapUiSmallMarginEnd"/>
                                <Button text="Mute Rule"                               press=".onMuteRule"/>
                            </HBox>

                            <!-- AI Remediation -->
                            <Panel id="aiPlaybookPanel" expandable="true" expanded="false">
                                <headerToolbar>
                                    <Toolbar>
                                        <Title text="AI Remediation Playbook" level="H6"/>
                                        <ToolbarSpacer/>
                                        <Button
                                            text="{= ${detail>/remediationLoading} ? 'Generating...' : 'Generate' }"
                                            icon="sap-icon://ai"
                                            type="Emphasized"
                                            press=".onGenerateRemediation"
                                            enabled="{= !${detail>/remediationLoading} }"/>
                                    </Toolbar>
                                </headerToolbar>
                                <content>
                                    <VBox class="sapUiSmallMargin">
                                        <BusyIndicator visible="{detail>/remediationLoading}" size="1rem"/>
                                        <Text
                                            visible="{= !${detail>/remediationLoading} &amp;&amp; !${detail>/remediationText} }"
                                            text="Click Generate to produce step-by-step SAP remediation steps."/>
                                        <FormattedText
                                            visible="{= !${detail>/remediationLoading} &amp;&amp; !!${detail>/remediationText} }"
                                            htmlText="{detail>/remediationText}"/>
                                    </VBox>
                                </content>
                            </Panel>
                        </VBox>
                    </content>
                </Panel>
                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
