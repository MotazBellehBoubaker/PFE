<mvc:View
    controllerName="sentinel.security.controller.Settings"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft><Title text="Settings" level="H4"/></contentLeft>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                

                    <!-- SAP S/4HANA Connection -->
                    <Panel headerText="SAP S/4HANA Connection · BTP Destination Service">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                    <Label text="Destination Name"/>
                                    <Text text="{settings>/destination/name}" class="sentinelMono"/>
                                    <Label text="Endpoint URL"/>
                                    <Text text="{settings>/destination/url}" class="sentinelMono"/>
                                    <Label text="Authentication"/>
                                    <ObjectStatus text="{settings>/destination/auth}" state="Information"/>
                                    <Label text="Last Test"/>
                                    <Text text="{settings>/destination/lastTest}" class="sentinelMono"/>
                                    <Label text="Status"/>
                                    <ObjectStatus
                                        text="Connected"
                                        state="Success"
                                        icon="{path: 'settings>/destination/connected', formatter: '.formatter.connectionIcon'}"/>
                        </VBox>
                            <Toolbar style="padding: 0 1rem 1rem">
                                <Button
                                    text="{= ${settings>/destination/testing} ? 'Testing…' : 'Test Connection' }"
                                    icon="sap-icon://connected"
                                    press=".onTestConnection"
                                    enabled="{= !${settings>/destination/testing} }"/>
                                <Button text="Edit in BTP Cockpit" icon="sap-icon://action" press=".onEditDestination"/>
                            </Toolbar>
                        </content>
                    </Panel>

                    <!-- Scan Schedule -->
                    <Panel headerText="Scan Schedule · SAP Job Scheduling Service">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                    <Label text="Cron Expression"/>
                                    <Input value="{settings>/schedule/cron}" class="sentinelMono"/>
                                    <Label text="Excessive Privilege Threshold (roles)"/>
                                    <Input value="{settings>/schedule/threshold}" type="Number"/>
                                    <Label text="Compliance Alert Threshold (%)"/>
                                    <Input value="{settings>/schedule/complianceAlert}" type="Number"/>
                        </VBox>
                            <Toolbar style="padding: 0 1rem 1rem">
                                <Button text="Save Settings" type="Emphasized" press=".onSaveSchedule"/>
                            </Toolbar>
                        </content>
                    </Panel>

                    <!-- Alert Routes -->
                    <Panel headerText="Alert Notification Routes · SAP Alert Notification Service">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                <CustomListItem>
                                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                        <core:Icon src="sap-icon://email" color="Accent4" class="sapUiSmallMarginEnd" size="1.2rem"/>
                                        <VBox width="100%">
                                            <Text text="Email · security-team@company.com" design="Bold"/>
                                            <Text text="All High severity violations" class="sapUiSmallText"/>
                                        </VBox>
                                        <ObjectStatus text="Active" state="Success" class="sapUiSmallMarginBegin"/>
                                    </HBox>
                                </CustomListItem>
                                <CustomListItem>
                                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                        <core:Icon src="sap-icon://collaborate" color="Accent5" class="sapUiSmallMarginEnd" size="1.2rem"/>
                                        <VBox width="100%">
                                            <Text text="Teams Webhook · SEC-OPS channel"/>
                                            <Text text="Critical roles and SAP_ALL assignments" class="sapUiSmallText"/>
                                        </VBox>
                                        <ObjectStatus text="Active" state="Success" class="sapUiSmallMarginBegin"/>
                                    </HBox>
                                </CustomListItem>
                                <CustomListItem>
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://share-2" color="Accent3" class="sapUiSmallMarginEnd" size="1.2rem"/>
                                        <VBox width="100%">
                                            <Text text="Webhook · https://hook.co/sentinel"/>
                                            <Text text="Compliance score below 70%" class="sapUiSmallText"/>
                                        </VBox>
                                        <ObjectStatus text="Active" state="Success" class="sapUiSmallMarginBegin"/>
                                    </HBox>
                                </CustomListItem>
                                <Button text="Add Route" icon="sap-icon://add" press=".onAddRoute" class="sapUiSmallMarginTop"/>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- XSUAA -->
                    <Panel headerText="XSUAA &amp; Authentication · SAP BTP IAM">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                    <Label text="Service Plan"/>   <Text text="Application"/>
                                    <Label text="Token URL"/>      <Text text="https://company.auth.eu10.hana.ondemand.com" class="sentinelMono sapUiSmallText"/>
                                    <Label text="Scopes"/>
                                    <HBox>
                                        <ObjectStatus text="sentinel.read"  state="Information" class="sapUiSmallMarginEnd"/>
                                        <ObjectStatus text="sentinel.admin" state="Information"/>
                                    </HBox>
                                    <Label text="Status"/>
                                    <ObjectStatus text="Configured" state="Success" icon="sap-icon://accept"/>
                        </VBox>
                        </content>
                    </Panel>

                
            </VBox>
        </content>
    </Page>
</mvc:View>
