                        icon="sap-icon://accept"/>
                    <Text text="{scans>/pipeline/stages/0/duration}" class="sentinelMono sapUiSmallText"/>
                </VBox>
            </content>
        </Panel>
        <core:Icon src="sap-icon://arrow-right" class="sapUiSmallMarginBeginEnd" color="Default"/>
        <Panel class="sentinelPipelineStage">
            <content>
