        </Panel>
        <core:Icon src="sap-icon://arrow-right" class="sapUiSmallMarginBeginEnd" color="Default"/>
        <Panel class="sentinelPipelineStage">
            <content>
                <VBox alignItems="Center" class="sapUiSmallMargin">
