<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <HBox alignItems="Center" wrap="Wrap">
        <Panel class="sentinelPipelineStage">
            <content>
                <VBox alignItems="Center" class="sapUiSmallMargin">
                    <ObjectStatus
                        text="{scans>/pipeline/stages/0/name}"
