<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        id="muteRuleDialog"
        title="Mute Rule Alerts"
        contentWidth="30rem"
        horizontalScrolling="false"
        verticalScrolling="true">
        <content>
            <VBox class="sapUiMediumMargin" width="auto">
                <Text
                    text="{= 'Suppress notifications for violations matching ' + ${detail>/selectedViolation/roleA} + ' + ' + ${detail>/selectedViolation/roleB} }"
                    wrapping="true"
                    class="sapUiSmallMarginBottom"/>
                <Label text="Mute Duration" required="true" class="sapUiTinyMarginBottom"/>
                <Select selectedKey="{mute>/duration}" width="100%" class="sapUiSmallMarginBottom">
                    <items>
                        <core:Item key="7"  text="7 days"/>
                        <core:Item key="14" text="14 days"/>
                        <core:Item key="30" text="30 days"/>
                        <core:Item key="90" text="90 days"/>
                    </items>
                </Select>
                <Label text="Reason for Muting" required="true" class="sapUiTinyMarginBottom"/>
                <TextArea
                    value="{mute>/reason}"
                    placeholder="e.g. Compensating control approved by CISO — dual approval workflow implemented"
                    rows="4"
                    width="100%"/>
            </VBox>
        </content>
        <buttons>
            <Button text="Mute" type="Emphasized" press=".onConfirmMuteRule"/>
            <Button text="Cancel" press=".onCancelMuteRule"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
