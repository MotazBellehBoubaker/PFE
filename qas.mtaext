_schema-version: '3.3'
ID: SentinelGRC-qas
extends: SentinelGRC

resources:
  - name: sentinelgrc-xsuaa
    parameters:
      config:
        xsappname: sentinelgrc-qas
        tenant-mode: dedicated
        role-collections:
          - name: SentinelGRC_QAS_SecurityAnalyst
            description: SentinelGRC Security Analyst (QAS)
            role-template-references:
              - $XSAPPNAME.SecurityAnalyst
          - name: SentinelGRC_QAS_BasisAdmin
            description: SentinelGRC Basis Administrator (QAS)
            role-template-references:
              - $XSAPPNAME.BasisAdmin
          - name: SentinelGRC_QAS_CISO
            description: SentinelGRC CISO / Executive (QAS)
            role-template-references:
              - $XSAPPNAME.CISO
          - name: SentinelGRC_QAS_Admin
            description: SentinelGRC Full Administrator (QAS)
            role-template-references:
              - $XSAPPNAME.Admin

  # ── Credential Store ─────────────────────────────────────────────
  # The "free" plan allows only 1 instance per subaccount, and the dev
  # space already holds it. dev/QAS/PROD share one subaccount, so QAS
  # cannot create its own. The "proxy" plan points at the dev instance
  # and inherits its quota instead of consuming a new one.
  - name: sentinelgrc-credstore
    parameters:
      service-plan: proxy
      config:
        origin:
          serviceGuid: c17f47a4-ab67-4f5a-a01c-b872a41baa31
