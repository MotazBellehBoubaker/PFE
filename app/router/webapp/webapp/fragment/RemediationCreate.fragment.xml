<core:FragmentDefinition
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Dialog id="createDialog" title="Schedule Remediation Task" contentWidth="600px" resizable="true" draggable="true">
        <beginButton>
            <Button text="Save" type="Emphasized" press=".handleDialogSaveButton"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".handleDialogCancelButton"/>
        </endButton>
        <l:VerticalLayout class="sapUiContentPadding" width="100%">

            <Label text="Issue Type:" labelFor="issueTypeSelect"/>
            <Select id="issueTypeSelect" width="100%" change=".onIssueTypeChanged">
                <core:Item key=""           text="-- Choose issue type --"/>
                <core:Item key="violation"  text="SoD Violation (ARA)"/>
                <core:Item key="compliance" text="Compliance / Missing Patch"/>
                <core:Item key="critical"   text="Critical Role / SAP_ALL"/>
                <core:Item key="manual"     text="Manual Task"/>
            </Select>

            <Label id="issuePickerLabel" text="Select Issue:" labelFor="issueSelect" visible="false"/>
            <Select id="issueSelect" width="100%" visible="false"
                forceSelection="false" change=".onIssueSelected">
                <core:Item key="" text="-- Select an item --"/>
            </Select>

            <Label text="Assign to:" labelFor="selectPerson"/>
            <Select id="selectPerson" forceSelection="false" width="100%"
                items="{path: 'remCal>/people'}">
                <core:Item key="{remCal>name}" text="{remCal>name}"/>
            </Select>

            <Label text="Title:" labelFor="inputTitle"/>
            <Input id="inputTitle" placeholder="Describe the action required"/>

            <Label text="Reference:" labelFor="violationRef"/>
            <Input id="violationRef" placeholder="e.g. VIO-031-001"/>

            <Label text="Affected User:" labelFor="affectedUser"/>
            <Input id="affectedUser" placeholder="SAP User ID"/>

            <Label text="Role / Item to Remove:" labelFor="roleToRemove"/>
            <Input id="roleToRemove" placeholder="e.g. Z_PAYM_APPROVE"/>

            <Label text="Priority:" labelFor="selectPriority"/>
            <Select id="selectPriority" width="100%">
                <core:Item key="High"   text="High"/>
                <core:Item key="Medium" text="Medium"/>
                <core:Item key="Low"    text="Low"/>
            </Select>

            <Label text="Start date:" labelFor="startDate"/>
            <DateTimePicker id="startDate" displayFormat="short"
                required="true" change=".handleCreateChange"/>

            <Label text="End date:" labelFor="endDate"/>
            <DateTimePicker id="endDate" displayFormat="short"
                required="true" change=".handleCreateChange"/>

            <Label text="Notes:" labelFor="moreInfo"/>
            <Input id="moreInfo" placeholder="Additional instructions for Basis admin"/>

        </l:VerticalLayout>
    </Dialog>

</core:FragmentDefinition>
