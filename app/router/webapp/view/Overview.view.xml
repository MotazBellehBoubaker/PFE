<mvc:View
    controllerName="sentinel.security.controller.Overview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:layout="sap.ui.layout">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Security Posture Overview" level="H4"/>
                    <ObjectStatus
                        text="{= 'Last scan: ' + ${ovState>/latestScanCode}}"
                        state="Success"
                        icon="sap-icon://accept"
                        class="sapUiSmallMarginBegin"/>
                </contentLeft>
                <contentRight>
                    <Button text="Export" icon="sap-icon://download" press=".onExportOverview"/>
                    <Button
                        text="{= ${appState>/scanning} ? 'Scanning...' : 'Trigger Scan' }"
                        icon="{= ${appState>/scanning} ? 'sap-icon://refresh' : 'sap-icon://play' }"
                        type="Emphasized"
                        press=".onTriggerScan"
                        enabled="{= !${appState>/scanning} }"
                        class="sapUiSmallMarginBegin"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <ProgressIndicator
                visible="{appState>/scanning}"
                percentValue="{= ${appState>/scanProgress} * 100 }"
                displayValue="{= 'Scanning ' + Math.round(${appState>/scanProgress} * 100) + '%' }"
                state="Information"
                class="sapUiNoMargin"/>

            <VBox class="sapUiMediumMargin">

                <!-- KPI Tiles -->
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile header="System Risk Score" subheader="Latest scan"
                        press=".onNavTo" frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent footer="{ovState>/latestScanCode}">
                                <content><NumericContent value="{ovState>/riskScore}" indicator="Up" valueColor="Critical" withMargin="false"/></content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                    <GenericTile header="Open Violations" subheader="{ovState>/violationSubheader}"
                        press=".onViewAllViolations" frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent footer="Latest scan">
                                <content><NumericContent value="{ovState>/violationsFound}" indicator="Up" valueColor="Critical" withMargin="false"/></content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                    <GenericTile header="Critical Roles" subheader="SAP_ALL holders"
                        press=".onNavToCritical" frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent footer="Super profiles assigned">
                                <content><NumericContent value="{ovState>/criticalRoles}" valueColor="Critical" withMargin="false"/></content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                    <GenericTile header="Compliance" subheader="Latest scan score"
                        press=".onNavToCompliance" frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="%" footer="Component baseline">
                                <content><NumericContent value="{ovState>/complianceScore}" indicator="Up" valueColor="Good" withMargin="false"/></content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                    <GenericTile header="Users Scanned" subheader="Latest scan"
                        frameType="TwoByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent footer="{ovState>/lockedSubheader}">
                                <content><NumericContent value="{ovState>/usersScanned}" valueColor="Neutral" withMargin="false"/></content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>

                <!-- Chart Row -->
                <layout:Grid defaultSpan="L4 M4 S12" class="sapUiSmallMarginBottom" hSpacing="1">
                    <layout:content>

                        <!-- Risk Score Trend Line -->
                        <Panel>
                            <layoutData><layout:GridData span="L8 M8 S12"/></layoutData>
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Risk Score and Violations Trend" level="H5"/>
                                    <ToolbarSpacer/>
                                    <ObjectStatus text="All scans" state="None"/>
                                </Toolbar>
                            </headerToolbar>
                            <content>
                                <viz:VizFrame
                                    id="trendVizFrame"
                                    vizType="line"
                                    uiConfig="{applicationSet:'fiori'}"
                                    height="260px"
                                    width="100%">
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset data="{ovState>/trendData}">
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition name="Scan" value="{ovState>scanCode}"/>
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition name="Risk Score"  value="{ovState>riskScore}"/>
                                                <viz.data:MeasureDefinition name="Violations"  value="{ovState>violationsFound}"/>
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <viz.feeds:FeedItem uid="valueAxis"    type="Measure"   values="Risk Score,Violations"/>
                                        <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Scan"/>
                                    </viz:feeds>
                                    <viz:dependents>
                                        <viz:Popover id="trendPopover"/>
                                    </viz:dependents>
                                </viz:VizFrame>
                            </content>
                        </Panel>

                        <!-- Severity Donut -->
                        <Panel>
                            <layoutData><layout:GridData span="L2 M2 S12"/></layoutData>
                            <headerToolbar>
                                <Toolbar><Title text="Severity" level="H5"/></Toolbar>
                            </headerToolbar>
                            <content>
                                <viz:VizFrame
                                    id="donutVizFrame"
                                    vizType="donut"
                                    uiConfig="{applicationSet:'fiori'}"
                                    height="260px"
                                    width="100%">
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset data="{ovState>/severityData}">
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition name="Severity" value="{ovState>severity}"/>
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition name="Count" value="{ovState>count}"/>
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <viz.feeds:FeedItem uid="size"  type="Measure"   values="Count"/>
                                        <viz.feeds:FeedItem uid="color" type="Dimension" values="Severity"/>
                                    </viz:feeds>
                                    <viz:dependents>
                                        <viz:Popover id="donutPopover"/>
                                    </viz:dependents>
                                </viz:VizFrame>
                            </content>
                        </Panel>

                        <!-- Compliance Bar -->
                        <Panel>
                            <layoutData><layout:GridData span="L2 M2 S12"/></layoutData>
                            <headerToolbar>
                                <Toolbar><Title text="Compliance" level="H5"/></Toolbar>
                            </headerToolbar>
                            <content>
                                <viz:VizFrame
                                    id="complianceVizFrame"
                                    vizType="bar"
                                    uiConfig="{applicationSet:'fiori'}"
                                    height="260px"
                                    width="100%">
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset data="{ovState>/complianceData}">
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition name="Status" value="{ovState>status}"/>
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition name="Components" value="{ovState>count}"/>
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <viz.feeds:FeedItem uid="valueAxis"    type="Measure"   values="Components"/>
                                        <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Status"/>
                                    </viz:feeds>
                                    <viz:dependents>
                                        <viz:Popover id="compliancePopover"/>
                                    </viz:dependents>
                                </viz:VizFrame>
                            </content>
                        </Panel>

                    </layout:content>
                </layout:Grid>

                <!-- AI Executive Briefing -->
                <Panel class="sapUiSmallMarginBottom">
                    <headerToolbar>
                        <Toolbar>
                            <core:Icon src="sap-icon://ai" color="Highlight" class="sapUiSmallMarginEnd"/>
                            <Title text="Executive Briefing" level="H5"/>
                            <ObjectStatus text="AI-powered" state="Information" class="sapUiSmallMarginBegin"/>
                            <ToolbarSpacer/>
                            <Button
                                text="{= ${appState>/execSummaryLoading} ? 'Generating...' : (${appState>/execSummary} ? 'Regenerate' : 'Generate Briefing') }"
                                icon="sap-icon://ai"
                                type="Emphasized"
                                press=".onGenerateBriefing"
                                enabled="{= !${appState>/execSummaryLoading} }"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <BusyIndicator visible="{appState>/execSummaryLoading}" size="1rem"/>
                            <Text visible="{= !${appState>/execSummaryLoading} &amp;&amp; !${appState>/execSummary} }"
                                text="Click Generate Briefing to produce a CISO-ready executive summary."/>
                            <FormattedText visible="{= !${appState>/execSummaryLoading} &amp;&amp; !!${appState>/execSummary} }"
                                htmlText="{appState>/execSummary}"/>
                        </VBox>
                    </content>
                </Panel>

                <!-- Recent High Violations -->
                <Panel class="sapUiSmallMarginBottom">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Recent High-Severity Violations" level="H5"/>
                            <ToolbarSpacer/>
                            <Button text="View all" type="Transparent" press=".onViewAllViolations"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table
                            id="recentViolationsList"
                            items="{
                                path: 'sentinelgrc>/Violations',
                                parameters: { $orderby: 'detectedAt desc' }
                            }"
                            mode="None">
                            <columns>
                                <Column width="10rem"><Text text="User"/></Column>
                                <Column><Text text="Conflicting Roles"/></Column>
                                <Column width="7rem"><Text text="Severity"/></Column>
                                <Column width="10rem"><Text text="Detected"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem press=".onViolationPress" type="Navigation"
                                    highlight="{path: 'sentinelgrc>severity', formatter: '.formatter.rowHighlight'}">
                                    <cells>
                                        <ObjectIdentifier title="{sentinelgrc>userName}" text="{sentinelgrc>userId}"/>
                                        <HBox alignItems="Center">
                                            <Text text="{sentinelgrc>roleA}" class="sentinelMono sentinelChip"/>
                                            <core:Icon src="sap-icon://arrow-right" class="sapUiSmallMarginBeginEnd"/>
                                            <Text text="{sentinelgrc>roleB}" class="sentinelMono sentinelChip"/>
                                        </HBox>
                                        <ObjectStatus text="{sentinelgrc>severity}"
                                            state="{path: 'sentinelgrc>severity', formatter: '.formatter.severityState'}"
                                            icon="{path: 'sentinelgrc>severity', formatter: '.formatter.severityIcon'}"/>
                                        <Text text="{path: 'sentinelgrc>detectedAt', formatter: '.formatter.formatDate'}" class="sentinelMono"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

                <!-- Top Risk Users -->
                <Panel>
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Top Risk Users" level="H5"/>
                            <ToolbarSpacer/>
                            <Button text="View all" type="Transparent" press=".onViewAllUsers"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table
                            items="{
                                path: 'sentinelgrc>/SapUsers',
                                parameters: { $orderby: 'riskScore desc' }
                            }"
                            mode="None">
                            <columns>
                                <Column><Text text="User"/></Column>
                                <Column width="8rem"><Text text="Department"/></Column>
                                <Column width="14rem"><Text text="Risk Score"/></Column>
                                <Column width="7rem"><Text text="Status"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem press=".onUserPress" type="Navigation">
                                    <cells>
                                        <HBox alignItems="Center">
                                            <Avatar
                                                initials="{path: 'sentinelgrc>userName', formatter: '.formatter.userInitials'}"
                                                backgroundColor="Accent6"
                                                displaySize="XS"
                                                class="sapUiSmallMarginEnd"/>
                                            <ObjectIdentifier title="{sentinelgrc>userName}" text="{sentinelgrc>userId}"/>
                                        </HBox>
                                        <Text text="{sentinelgrc>department}"/>
                                        <ProgressIndicator
                                            percentValue="{sentinelgrc>riskScore}"
                                            displayValue="{sentinelgrc>riskScore}"
                                            width="160px"
                                            state="{path: 'sentinelgrc>riskScore', formatter: '.formatter.riskScoreState'}"/>
                                        <ObjectStatus
                                            text="{= ${sentinelgrc>locked} ? 'Locked' : 'Active'}"
                                            state="{= ${sentinelgrc>locked} ? 'Warning' : 'Success'}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
