<mvc:View
    controllerName="sentinel.security.controller.Compliance"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Patch and Baseline Compliance" level="H4"/>
                    <ObjectStatus
                        text="{= 'Last evaluated: ' + ${compState>/lastEvaluated}}"
                        state="None"
                        class="sapUiSmallMarginBegin"/>
                </contentLeft>
                <contentRight>
                    <Button text="Re-evaluate Baseline" icon="sap-icon://refresh" type="Emphasized" press=".onReevaluate"/>
                    <Button text="Export Report" icon="sap-icon://download" press=".onExportReport" class="sapUiSmallMarginBegin"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- KPI Row -->
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile header="Compliance Score" subheader="Latest scan" frameType="TwoByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="%">
                                <content>
                                    <NumericContent value="{compState>/complianceScore}" indicator="Up" valueColor="Good" withMargin="false"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                    <GenericTile header="Compliant" subheader="Components up to date" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content>
                            <NumericContent value="{compState>/compliantCount}" valueColor="Good" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Outdated" subheader="Need patching" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content>
                            <NumericContent value="{compState>/outdatedCount}" valueColor="Critical" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Missing Notes" subheader="SAP Security Notes" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content>
                            <NumericContent value="{compState>/missingNotes}" valueColor="Critical" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                </HBox>

                <!-- Warning strip -->
                <MessageStrip
                    text="{compState>/warningText}"
                    type="Warning"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>

                <!-- Charts Row -->
                <layout:Grid defaultSpan="L12 M12 S12" hSpacing="1" class="sapUiSmallMarginBottom">
                    <layout:content>

                    <!-- Compliance Trend Line -->
                    <Panel>
                        <layoutData><layout:GridData span="L8 M8 S12"/></layoutData>
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Compliance Score Trend" level="H5"/>
                                <ToolbarSpacer/>
                                <ObjectStatus text="All scans" state="None"/>
                            </Toolbar>
                        </headerToolbar>
                        <content>
                            <viz:VizFrame
                                id="complianceTrendViz"
                                vizType="line"
                                uiConfig="{applicationSet:'fiori'}"
                                height="240px"
                                width="100%">
                                <viz:dataset>
                                    <viz.data:FlattenedDataset data="{compState>/trendData}">
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition name="Scan" value="{compState>scanCode}"/>
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition name="Compliance %" value="{compState>complianceScore}"/>
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem uid="valueAxis"    type="Measure"   values="Compliance %"/>
                                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Scan"/>
                                </viz:feeds>
                                <viz:dependents>
                                    <viz:Popover id="complianceTrendPopover"/>
                                </viz:dependents>
                            </viz:VizFrame>
                        </content>
                    </Panel>

                    <!-- Component Status Donut -->
                    <Panel>
                        <layoutData><layout:GridData span="L4 M4 S12"/></layoutData>
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Component Status" level="H5"/>
                            </Toolbar>
                        </headerToolbar>
                        <content>
                            <viz:VizFrame
                                id="complianceDonutViz"
                                vizType="donut"
                                uiConfig="{applicationSet:'fiori'}"
                                height="240px"
                                width="100%">
                                <viz:dataset>
                                    <viz.data:FlattenedDataset data="{compState>/donutData}">
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition name="Status" value="{compState>status}"/>
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition name="Components" value="{compState>count}"/>
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem uid="size"  type="Measure"   values="Components"/>
                                    <viz.feeds:FeedItem uid="color" type="Dimension" values="Status"/>
                                </viz:feeds>
                                <viz:dependents>
                                    <viz:Popover id="complianceDonutPopover"/>
                                </viz:dependents>
                            </viz:VizFrame>
                        </content>
                    </Panel>

                    </layout:content>
                </layout:Grid>

                <!-- SAP Security Notes -->
                <Panel expandable="true" expanded="true" class="sapUiSmallMarginBottom">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Missing SAP Security Notes" level="H5"/>
                            <ObjectStatus text="{compState>/missingNotes} missing" state="Warning" class="sapUiSmallMarginBegin"/>
                            <ToolbarSpacer/>
                            <Button text="Open SAP Launchpad" icon="sap-icon://action" type="Transparent" press=".onOpenSAPNotes"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table
                            id="notesTable"
                            items="{
                                path: 'sentinelgrc>/SecurityNotes',
                                parameters: { $orderby: 'priority asc' }
                            }"
                            mode="None"
                            sticky="ColumnHeaders"
                            updateFinished=".onNotesUpdateFinished">
                            <columns>
                                <Column width="8rem"><Text text="Note #"/></Column>
                                <Column width="9rem"><Text text="Component"/></Column>
                                <Column width="7rem"><Text text="Priority"/></Column>
                                <Column width="7rem"><Text text="Category"/></Column>
                                <Column><Text text="Description"/></Column>
                                <Column width="8rem"><Text text="Release Date"/></Column>
                                <Column width="7rem"><Text text="Status"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem
                                    highlight="{path: 'sentinelgrc>priority', formatter: '.formatter.rowHighlight'}"
                                    type="Active"
                                    press=".onNotePress">
                                    <cells>
                                        <Link text="{sentinelgrc>noteId}" press=".onNotePress" class="sentinelMono"/>
                                        <Text text="{sentinelgrc>component}" class="sentinelMono"/>
                                        <ObjectStatus
                                            text="{sentinelgrc>priority}"
                                            state="{path: 'sentinelgrc>priority', formatter: '.formatter.severityState'}"/>
                                        <Text text="{sentinelgrc>category}"/>
                                        <Text text="{sentinelgrc>description}" wrapping="false"/>
                                        <Text text="{path: 'sentinelgrc>releaseDate', formatter: '.formatter.formatDate'}" class="sentinelMono"/>
                                        <ObjectStatus text="Missing" state="Error" icon="sap-icon://alert"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

                <!-- Component version table -->
                <Panel>
                    <headerToolbar>
                        <Toolbar>
                            <Title text="SAP Component Versions (CVERS)" level="H5"/>
                            <ToolbarSpacer/>
                            <Button text="Re-extract CVERS" icon="sap-icon://refresh" press=".onReevaluate" type="Transparent"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table
                            id="componentsTable"
                            items="{
                                path: 'sentinelgrc>/ComplianceComponents',
                                parameters: { $orderby: 'status asc' }
                            }"
                            mode="None"
                            sticky="ColumnHeaders"
                            updateFinished=".onComponentsUpdateFinished">
                            <columns>
                                <Column width="12rem"><Text text="Component"/></Column>
                                <Column width="9rem"> <Text text="Installed"/></Column>
                                <Column width="9rem"> <Text text="Required"/></Column>
                                <Column width="6rem"> <Text text="Delta"/></Column>
                                <Column width="8rem"> <Text text="Status"/></Column>
                                <Column>              <Text text="Risk Note"/></Column>
                                <Column width="8rem"> <Text text="Action"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem
                                    highlight="{= ${sentinelgrc>status} === 'Outdated' ? 'Warning' : 'Success'}">
                                    <cells>
                                        <ObjectIdentifier title="{sentinelgrc>name}" class="sentinelMono"/>
                                        <Text text="{sentinelgrc>installedVersion}" class="sentinelMono"/>
                                        <Text text="{sentinelgrc>requiredVersion}" class="sentinelMono"/>
                                        <ObjectNumber
                                            number="{sentinelgrc>delta}"
                                            state="{= ${sentinelgrc>delta} > 0 ? 'Error' : 'Success'}"
                                            unit="patches"/>
                                        <ObjectStatus
                                            text="{sentinelgrc>status}"
                                            state="{= ${sentinelgrc>status} === 'Outdated' ? 'Warning' : 'Success'}"
                                            icon="{= ${sentinelgrc>status} === 'Outdated' ? 'sap-icon://alert' : 'sap-icon://accept'}"/>
                                        <Text text="{sentinelgrc>riskNote}"/>
                                        <Button
                                            visible="{= ${sentinelgrc>status} === 'Outdated'}"
                                            text="Schedule Patch"
                                            icon="sap-icon://appointment-2"
                                            type="Transparent"
                                            press=".onSchedulePatch"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
