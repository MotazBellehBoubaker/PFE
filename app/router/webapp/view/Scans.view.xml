<mvc:View
    controllerName="sentinel.security.controller.Scans"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft><Title text="Scan History" level="H4"/></contentLeft>
                <contentRight>
                    <Button text="Export" icon="sap-icon://download" press=".onExport"/>
                    <Button text="Trigger Scan" icon="sap-icon://play" type="Emphasized" press=".onTriggerScan" class="sapUiSmallMarginBegin"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- KPI row -->
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile header="Total Scans" subheader="All time" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content>
                            <NumericContent value="{scansState>/totalScans}" valueColor="Neutral" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Avg Duration" subheader="Seconds per scan" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent unit="s"><content>
                            <NumericContent value="{scansState>/avgDuration}" valueColor="Good" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Latest Risk" subheader="{scansState>/latestScanCode}" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content>
                            <NumericContent value="{scansState>/latestRisk}" valueColor="Critical" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Latest Compliance" subheader="{scansState>/latestScanCode}" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent unit="%"><content>
                            <NumericContent value="{scansState>/latestCompliance}" valueColor="Good" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                </HBox>

                <!-- Scan trend chart -->
                <Panel headerText="Risk Score Trend" class="sapUiSmallMarginBottom">
                    <content>
                        <viz:VizFrame
                            id="scansTrendVizFrame"
                            vizType="line"
                            uiConfig="{applicationSet:'fiori'}"
                            height="220px"
                            width="100%">
                            <viz:dataset>
                                <viz.data:FlattenedDataset data="{scansState>/chartData}">
                                    <viz.data:dimensions>
                                        <viz.data:DimensionDefinition name="Scan" value="{scansState>scanCode}"/>
                                    </viz.data:dimensions>
                                    <viz.data:measures>
                                        <viz.data:MeasureDefinition name="Risk Score"    value="{scansState>riskScore}"/>
                                        <viz.data:MeasureDefinition name="Violations"    value="{scansState>violationsFound}"/>
                                        <viz.data:MeasureDefinition name="Compliance %"  value="{scansState>complianceScore}"/>
                                    </viz.data:measures>
                                </viz.data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <viz.feeds:FeedItem uid="valueAxis"    type="Measure"   values="Risk Score,Violations,Compliance %"/>
                                <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Scan"/>
                            </viz:feeds>
                            <viz:dependents>
                                <viz:Popover id="scansTrendPopover"/>
                            </viz:dependents>
                        </viz:VizFrame>
                    </content>
                </Panel>

                <!-- Scan history table -->
                <Panel headerText="All Scans">
                    <content>
                        <Table
                            id="scansTable"
                            items="{
                                path: 'sentinelgrc>/ScanResults',
                                parameters: { $orderby: 'startedAt desc' }
                            }"
                            mode="None"
                            sticky="ColumnHeaders"
                            growing="true"
                            growingThreshold="10"
                            updateFinished=".onTableUpdateFinished">
                            <columns>
                                <Column width="9rem"><Text text="Scan ID"/></Column>
                                <Column width="12rem"><Text text="Started"/></Column>
                                <Column width="7rem"><Text text="Duration"/></Column>
                                <Column><Text text="Trigger"/></Column>
                                <Column width="6rem"><Text text="Users"/></Column>
                                <Column width="10rem"><Text text="Violations"/></Column>
                                <Column width="6rem"><Text text="Risk"/></Column>
                                <Column width="10rem"><Text text="Compliance"/></Column>
                                <Column width="7rem"><Text text="Status"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <ObjectIdentifier title="{sentinelgrc>scanCode}" class="sentinelMono"/>
                                        <Text text="{path: 'sentinelgrc>startedAt', formatter: '.formatter.formatDate'}" class="sentinelMono"/>
                                        <Text text="{sentinelgrc>durationSec}s" class="sentinelMono"/>
                                        <Text text="{sentinelgrc>trigger}"/>
                                        <ObjectNumber number="{sentinelgrc>usersScanned}"/>
                                        <HBox>
                                            <ObjectNumber number="{sentinelgrc>violationsFound}" emphasized="true"/>
                                            <Text text=" ({sentinelgrc>highCount}H {sentinelgrc>mediumCount}M {sentinelgrc>lowCount}L)" class="sapUiSmallText sapUiSmallMarginBegin"/>
                                        </HBox>
                                        <ObjectNumber number="{sentinelgrc>riskScore}" emphasized="true"/>
                                        <ProgressIndicator
                                            percentValue="{sentinelgrc>complianceScore}"
                                            displayValue="{sentinelgrc>complianceScore}%"
                                            width="90px"
                                            state="Success"/>
                                        <ObjectStatus
                                            text="{sentinelgrc>status}"
                                            state="{path: 'sentinelgrc>status', formatter: '.formatter.scanStatusState'}"
                                            icon="sap-icon://accept"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
