<mvc:View
    controllerName="sentinel.security.controller.RemediationCalendar"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:unified="sap.ui.unified"
    xmlns="sap.m">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Remediation Calendar" level="H4"/>
                </contentLeft>
                <contentRight>
                    <Button text="Schedule Task" icon="sap-icon://add" type="Emphasized" press=".handleAppointmentCreate"/>
                    <Button text="Export" icon="sap-icon://download" press=".onExport" class="sapUiSmallMarginBegin"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- KPI tiles -->
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile id="tileScheduled" header="Scheduled" subheader="Pending remediation"
                        frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content>
                            <NumericContent id="numScheduled" value="0" valueColor="Critical" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile id="tileInProgress" header="In Progress" subheader="Being executed"
                        frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content>
                            <NumericContent id="numInProgress" value="0" valueColor="Warning" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile id="tileDone" header="Completed" subheader="This period"
                        frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content>
                            <NumericContent id="numDone" value="0" valueColor="Good" withMargin="false"/>
                        </content></TileContent></tileContent>
                    </GenericTile>
                </HBox>

                <!-- Planning Calendar — exact SAP sample pattern -->
                <PlanningCalendar
                    id="remediationCalendar"
                    startDate="{remCal>/startDate}"
                    rows="{remCal>/people}"
                    appointmentsVisualization="Filled"
                    appointmentSelect=".handleAppointmentSelect"
                    intervalSelect=".handleAppointmentAddWithContext"
                    showEmptyIntervalHeaders="false">
                    <toolbarContent>
                        <Title text="Basis Admin Remediation Schedule" titleStyle="H5"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://add" type="Emphasized"
                            tooltip="Schedule new remediation task"
                            press=".handleAppointmentCreate"/>
                    </toolbarContent>
                    <rows>
                        <PlanningCalendarRow
                            icon="{remCal>pic}"
                            title="{remCal>name}"
                            text="{remCal>role}"
                            appointments="{path: 'remCal>appointments', templateShareable: false}"
                            intervalHeaders="{path: 'remCal>headers', templateShareable: false}">
                            <appointments>
                                <unified:CalendarAppointment
                                    startDate="{remCal>start}"
                                    endDate="{remCal>end}"
                                    title="{remCal>title}"
                                    text="{remCal>info}"
                                    type="{remCal>type}"
                                    tentative="{remCal>tentative}"/>
                            </appointments>
                            <intervalHeaders>
                                <unified:CalendarAppointment
                                    startDate="{remCal>start}"
                                    endDate="{remCal>end}"
                                    title="{remCal>title}"
                                    type="{remCal>type}"/>
                            </intervalHeaders>
                        </PlanningCalendarRow>
                    </rows>
                </PlanningCalendar>

                <!-- Tasks Table + Detail side by side -->
                <HBox width="100%" alignItems="Stretch" renderType="Bare" class="sapUiSmallMarginTop">
                <Panel>
                    <layoutData>
                        <FlexItemData growFactor="3" baseSize="0" shrinkFactor="1"/>
                    </layoutData>
                    <headerToolbar>
                        <Toolbar>
                            <Title text="All Remediation Tasks" level="H5"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table id="allTasksList" growing="true" growingThreshold="20"
                            noDataText="No remediation tasks found"
                            mode="SingleSelectMaster"
                            selectionChange=".onTaskSelect"
                            sticky="ColumnHeaders">
                            <columns>
                                <Column width="7rem"><Text text="Task ID"/></Column>
                                <Column width="7rem"><Text text="Priority"/></Column>
                                <Column><Text text="Action Required"/></Column>
                                <Column width="10rem"><Text text="Affected User"/></Column>
                                <Column width="9rem"><Text text="Violation Ref"/></Column>
                                <Column width="10rem"><Text text="Scheduled"/></Column>
                                <Column width="9rem"><Text text="Assigned To"/></Column>
                                <Column width="8rem"><Text text="Status"/></Column>
                            </columns>
                        </Table>
                    </content>
                </Panel>

                <!-- Detail Panel (right side) -->
                <Panel
                    id="taskDetailPanel"
                    visible="{= !!${taskDetail>/selectedTask} }"
                    class="sapUiSmallMarginBegin">
                    <layoutData>
                        <FlexItemData growFactor="2" baseSize="0" shrinkFactor="1"/>
                    </layoutData>
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{taskDetail>/selectedTask/id}" level="H5" class="sentinelMono"/>
                            <ToolbarSpacer/>
                            <ObjectStatus
                                text="{taskDetail>/selectedTask/priority}"
                                state="{path: 'taskDetail>/selectedTask/priority', formatter: '.formatter.severityState'}"/>
                            <Button
                                icon="sap-icon://decline"
                                type="Transparent"
                                tooltip="Close details"
                                press=".onCloseTaskDetail"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <Title text="{taskDetail>/selectedTask/title}" level="H5" class="sapUiSmallMarginBottom"/>

                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="User:" width="110px"/>
                                <Text text="{taskDetail>/selectedTask/userId}" class="sentinelMono"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Remove:" width="110px"/>
                                <Text text="{taskDetail>/selectedTask/roleToRemove}" class="sentinelMono sentinelChip"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Reference:" width="110px"/>
                                <Text text="{taskDetail>/selectedTask/violationId}" class="sentinelMono"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Assigned To:" width="110px"/>
                                <Text text="{taskDetail>/selectedTask/assignedTo}"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Scheduled:" width="110px"/>
                                <Text text="{path: 'taskDetail>/selectedTask/start', formatter: '.formatDate'}" class="sentinelMono"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Due:" width="110px"/>
                                <Text text="{path: 'taskDetail>/selectedTask/end', formatter: '.formatDate'}" class="sentinelMono"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Status:" width="110px"/>
                                <ObjectStatus
                                    text="{taskDetail>/selectedTask/status}"
                                    state="{path: 'taskDetail>/selectedTask/status', formatter: '.formatStatusState'}"/>
                            </HBox>
                            <HBox class="sapUiSmallMarginBottom">
                                <Label text="Notes:" width="110px"/>
                                <Text text="{taskDetail>/selectedTask/notes}" wrapping="true"/>
                            </HBox>

                            <!-- Actions -->
                            <HBox class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                                <Button text="Edit" icon="sap-icon://edit" type="Emphasized"
                                    press=".onEditSelectedTask" class="sapUiSmallMarginEnd"/>
                                <Button text="Mark as Done" icon="sap-icon://accept" type="Accept"
                                    press=".onCompleteSelectedTask" class="sapUiSmallMarginEnd"
                                    enabled="{= ${taskDetail>/selectedTask/status} !== 'Done' }"/>
                                <Button text="Delete" icon="sap-icon://delete" type="Reject"
                                    press=".onDeleteSelectedTask"/>
                            </HBox>
                        </VBox>
                    </content>
                </Panel>
                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
