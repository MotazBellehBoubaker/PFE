<mvc:View
    controllerName="sentinel.security.controller.Settings"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft><Title text="Settings" level="H4"/></contentLeft>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                

                    <!-- SAP S/4HANA Connection -->
                    <Panel headerText="SAP S/4HANA Connection · BTP Destination Service">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                    <Label text="Destination Name"/>
                                    <Text text="{settings>/destination/name}" class="sentinelMono"/>
                                    <Label text="Endpoint URL"/>
                                    <Text text="{settings>/destination/url}" class="sentinelMono"/>
                                    <Label text="Authentication"/>
                                    <ObjectStatus text="{settings>/destination/auth}" state="Information"/>
                                    <Label text="Last Test"/>
                                    <Text text="{settings>/destination/lastTest}" class="sentinelMono"/>
                                    <Label text="Status"/>
                                    <ObjectStatus
                                        text="Connected"
                                        state="Success"
                                        icon="{path: 'settings>/destination/connected', formatter: '.formatter.connectionIcon'}"/>
                        </VBox>
                            <Toolbar style="padding: 0 1rem 1rem">
                                <Button
                                    text="{= ${settings>/destination/testing} ? 'Testing…' : 'Test Connection' }"
                                    icon="sap-icon://connected"
                                    press=".onTestConnection"
                                    enabled="{= !${settings>/destination/testing} }"/>
                                <Button text="Edit in BTP Cockpit" icon="sap-icon://action" press=".onEditDestination"/>
                            </Toolbar>
                        </content>
                    </Panel>

                    <!-- Scan Schedule -->
                    <Panel headerText="Automated Scan Schedule">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <Label text="Enable automatic scans" class="sapUiSmallMarginEnd"/>
                                    <Switch state="{settings>/schedule/enabled}"/>
                                </HBox>
                                <Label text="Scan Frequency"/>
                                <Select
                                    selectedKey="{settings>/schedule/frequencyKey}"
                                    enabled="{settings>/schedule/enabled}"
                                    change=".onFrequencyChange"
                                    class="sapUiSmallMarginBottom">
                                    <core:Item key="15min"   text="Every 15 minutes"/>
                                    <core:Item key="30min"   text="Every 30 minutes"/>
                                    <core:Item key="1hour"   text="Every hour"/>
                                    <core:Item key="6hours"  text="Every 6 hours"/>
                                    <core:Item key="12hours" text="Every 12 hours"/>
                                    <core:Item key="daily"   text="Once a day (midnight)"/>
                                    <core:Item key="weekly"  text="Once a week (Monday, midnight)"/>
                                    <core:Item key="custom"  text="Custom (advanced)"/>
                                </Select>
                                <VBox visible="{= ${settings>/schedule/frequencyKey} === 'custom' }">
                                    <Label text="Cron Expression"/>
                                    <Input value="{settings>/schedule/cron}" class="sentinelMono" enabled="{settings>/schedule/enabled}"/>
                                    <Text text="Standard 5-field cron syntax (minute hour day month weekday). Minimum supported interval: 1 minute." class="sentinelSuggLabel sapUiTinyMarginTop sapUiSmallMarginBottom"/>
                                </VBox>
                                <Text text="{= 'Next scans will run: ' + ${settings>/schedule/frequencyLabel} }" class="sentinelSuggLabel sapUiSmallMarginBottom"/>
                                <HBox class="sapUiSmallMarginTop">
                                    <Label text="Last automatic run:" class="sapUiTinyMarginEnd"/>
                                    <Text text="{settings>/schedule/lastRun}" class="sentinelMono"/>
                                </HBox>
                            </VBox>
                            <Toolbar style="padding: 0 1rem 1rem">
                                <Button
                                    text="{= ${settings>/schedule/saving} ? 'Saving…' : 'Save Settings' }"
                                    enabled="{= !${settings>/schedule/saving} }"
                                    type="Emphasized"
                                    press=".onSaveSchedule"/>
                            </Toolbar>
                        </content>
                    </Panel>

                    <!-- Alert Routes -->
                    <Panel headerText="Alert Notification Routes · SAP Alert Notification Service">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                <CustomListItem>
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://email" color="Accent4" class="sapUiSmallMarginEnd" size="1.2rem"/>
                                        <VBox width="100%">
                                            <Text text="Email · motaz.boubaker@aymax.fr" design="Bold"/>
                                            <Text text="Scan-completed events, all severities" class="sapUiSmallText"/>
                                        </VBox>
                                        <ObjectStatus text="Active" state="Success" class="sapUiSmallMarginBegin"/>
                                    </HBox>
                                </CustomListItem>
                                <Button text="Manage in ANS Cockpit" icon="sap-icon://action" press=".onAddRoute" class="sapUiSmallMarginTop"/>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- XSUAA -->
                    <Panel headerText="XSUAA &amp; Authentication · SAP BTP IAM">
                        <content>
                            <VBox class="sapUiSmallMargin">
                                    <Label text="Service Plan"/>   <Text text="Application"/>
                                    <Label text="Token URL"/>      <Text text="https://aymax-consulting-dev-azure-442muemm.authentication.eu20.hana.ondemand.com" class="sentinelMono sapUiSmallText"/>
                                    <Label text="Scopes"/>
                                    <HBox>
                                        <ObjectStatus text="{settings>/userRole}" state="Information"/>
                                    </HBox>
                                    <Label text="Status"/>
                                    <ObjectStatus text="Configured" state="Success" icon="sap-icon://accept"/>
                        </VBox>
                        </content>
                    </Panel>

                
            </VBox>
        </content>
    </Page>
</mvc:View>
