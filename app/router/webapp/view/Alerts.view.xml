<mvc:View
    controllerName="sentinel.security.controller.Alerts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft><Title text="Alert Notification Log" level="H4"/></contentLeft>
                <contentRight>
                    <Button text="Manage Routes" icon="sap-icon://settings" press=".onManageRoutes"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- KPI row -->
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile header="Sent Today"     subheader="Across all channels"       frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><NumericContent value="{alerts>/sentToday}" valueColor="Neutral" withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Delivery Rate"  subheader="Last 24h · no failures"    frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent unit="%"><content><NumericContent value="100" valueColor="Good"    withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Active Routes"  subheader="2 email · 1 Teams · 1 webhook" frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><NumericContent value="4"    valueColor="Neutral" withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                    <GenericTile header="Muted Rules"    subheader="No suppressions active"    frameType="OneByOne" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent><TileContent><content><NumericContent value="0"    valueColor="Good"    withMargin="false"/></content></TileContent></tileContent>
                    </GenericTile>
                </HBox>

                <!-- Alerts list -->
                <Panel>
                    <headerToolbar>
                        <Toolbar>
                            <SearchField
                                placeholder="Search alerts…"
                                width="240px"
                                search=".onSearch"
                                liveChange=".onSearch"/>
                            <ToolbarSpacer/>
                            <Label text="Severity:"/>
                            <Select change=".onSeverityFilter">
                                <items>
                                    <core:Item key="All"    text="All"/>
                                    <core:Item key="High"   text="High"/>
                                    <core:Item key="Medium" text="Medium"/>
                                    <core:Item key="Low"    text="Low"/>
                                </items>
                            </Select>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table
                            id="alertsList"
                            items="{alerts>/alerts}"
                            mode="None"
                            sticky="ColumnHeaders">
                            <columns>
                                <Column width="10rem"> <Text text="Time"/>       </Column>
                                <Column width="7rem">  <Text text="Severity"/>   </Column>
                                <Column>               <Text text="Subject"/>    </Column>
                                <Column width="9rem">  <Text text="Channel"/>    </Column>
                                <Column>               <Text text="Recipient"/>  </Column>
                                <Column width="8rem">  <Text text="Status"/>     </Column>
                            </columns>
                            <items>
                                <ColumnListItem
                                    highlight="{path: 'alerts>severity', formatter: '.formatter.rowHighlight'}">
                                    <cells>
                                        <Text text="{alerts>time}" class="sentinelMono"/>
                                        <ObjectStatus
                                            text="{alerts>severity}"
                                            state="{path: 'alerts>severity', formatter: '.formatter.severityState'}"/>
                                        <VBox>
                                            <Text text="{alerts>subject}" wrapping="false"/>
                                            <Text text="{alerts>id}" class="sentinelMono sapUiSmallText"/>
                                        </VBox>
                                        <Text text="{alerts>channel}"/>
                                        <Text text="{alerts>recipient}" class="sentinelMono sapUiSmallText"/>
                                        <ObjectStatus text="{alerts>status}" state="Success" icon="sap-icon://accept"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
