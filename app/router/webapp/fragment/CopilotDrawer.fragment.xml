<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!-- Copilot Popover triggered from App shell button -->
    <Dialog
        id="copilotDialog"
        title="Risk Co-pilot"
        contentWidth="420px"
        contentHeight="600px"
        verticalScrolling="false"
        resizable="true"
        draggable="true">

        <customHeader>
            <Bar>
                <contentLeft>
                    <core:Icon src="sap-icon://ai" size="1.2rem" color="Accent4"/>
                    <Title text="Risk Co-pilot" level="H5" class="sapUiSmallMarginBegin"/>
                </contentLeft>
                <contentMiddle>
                    <ObjectStatus
                        text="Grounded on SC-2026-031"
                        state="Success"
                        icon="sap-icon://connected"/>
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://delete" type="Transparent" press=".onClearChat" tooltip="Clear chat"/>
                    <Button icon="sap-icon://decline" type="Transparent" press=".onCloseCopilot" tooltip="Close"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox height="100%" width="100%">
                <!-- Messages list -->
                <ScrollContainer
                    id="copilotScroll"
                    vertical="true"
                    horizontal="false"
                    height="430px"
                    width="100%">
                    <List
                        id="copilotMessagesList"
                        items="{appState>/copilotMessages}"
                        showSeparators="None"
                        backgroundDesign="Transparent">
                        <items>
                            <CustomListItem>
                                <VBox class="sapUiSmallMarginTopBottom">
                                    <!-- User message -->
                                    <HBox
                                        visible="{= ${appState>role} === 'user' }"
                                        justifyContent="End"
                                        class="sapUiSmallMarginBottom">
                                        <VBox alignItems="End">
                                            <Text text="You" class="sapUiSmallText sapUiSmallMarginBottom"/>
                                            <Panel backgroundDesign="Solid" class="sentinelUserBubble">
                                                <content>
                                                    <Text text="{appState>content}" wrapping="true"/>
                                                </content>
                                            </Panel>
                                        </VBox>
                                    </HBox>
                                    <!-- Bot message -->
                                    <HBox
                                        visible="{= ${appState>role} === 'assistant' }"
                                        class="sapUiSmallMarginBottom">
                                        <core:Icon
                                            src="sap-icon://ai"
                                            color="Accent4"
                                            size="1rem"
                                            class="sapUiSmallMarginEnd sapUiTinyMarginTop"/>
                                        <VBox>
                                            <Text text="Co-pilot" class="sapUiSmallText sapUiSmallMarginBottom"/>
                                            <Panel backgroundDesign="Translucent" class="sentinelBotBubble">
                                                <content>
                                                    <FormattedText htmlText="{appState>htmlContent}" wrapping="true"/>
                                                </content>
                                            </Panel>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </CustomListItem>
                        </items>
                    </List>
                </ScrollContainer>

                <!-- Suggestions -->
                <HBox
                    id="copilotSuggestions"
                    visible="{= ${appState>/copilotMessages}.length === 0 }"
                    wrap="Wrap"
                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
                    <Button text="Summarize today's scan"  press=".onSuggestion" class="sapUiSmallMarginEnd sapUiSmallMarginBottom sentinelSuggBtn"/>
                    <Button text="Prioritize violations"   press=".onSuggestion" class="sapUiSmallMarginEnd sapUiSmallMarginBottom sentinelSuggBtn"/>
                    <Button text="Why is JKOWAL high risk?" press=".onSuggestion" class="sapUiSmallMarginEnd sapUiSmallMarginBottom sentinelSuggBtn"/>
                    <Button text="Remediate SAP_ALL"        press=".onSuggestion" class="sapUiSmallMarginEnd sapUiSmallMarginBottom sentinelSuggBtn"/>
                    <Button text="What changed?"            press=".onSuggestion" class="sapUiSmallMarginEnd sapUiSmallMarginBottom sentinelSuggBtn"/>
                </HBox>
            </VBox>
        </content>

        <buttons>
            <Button id="copilotInput" type="Transparent" visible="false"/>
        </buttons>

        <footer>
            <Bar>
                <contentMiddle>
                    <Input
                        id="copilotInputField"
                        placeholder="Ask about a user, violation, or scan…"
                        width="320px"
                        submit=".onCopilotSubmit"/>
                    <Button
                        icon="sap-icon://paper-plane"
                        type="Emphasized"
                        press=".onCopilotSubmit"
                        enabled="{= !${appState>/copilotLoading} }"
                        class="sapUiSmallMarginBegin"/>
                </contentMiddle>
            </Bar>
        </footer>
    </Dialog>

</core:FragmentDefinition>
