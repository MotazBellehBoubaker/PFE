{
  "welcomeFile": "/webapp/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/security-service/(.*)$",
      "target": "/security-service/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/webapp/(.*)$",
      "target": "$1",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    }
  ]
}
