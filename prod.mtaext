_schema-version: '3.3'
ID: SentinelGRC-prod
extends: SentinelGRC

resources:
  - name: sentinelgrc-xsuaa
    parameters:
      config:
        xsappname: sentinelgrc-prod
        tenant-mode: dedicated
        role-collections:
          - name: SentinelGRC_PROD_SecurityAnalyst
            description: SentinelGRC Security Analyst (PROD)
            role-template-references:
              - $XSAPPNAME.SecurityAnalyst
          - name: SentinelGRC_PROD_BasisAdmin
            description: SentinelGRC Basis Administrator (PROD)
            role-template-references:
              - $XSAPPNAME.BasisAdmin
          - name: SentinelGRC_PROD_CISO
            description: SentinelGRC CISO / Executive (PROD)
            role-template-references:
              - $XSAPPNAME.CISO
          - name: SentinelGRC_PROD_Admin
            description: SentinelGRC Full Administrator (PROD)
            role-template-references:
              - $XSAPPNAME.Admin

  # ── Credential Store ─────────────────────────────────────────────
  # The "free" plan allows only 1 instance per subaccount, and the dev
  # space already holds it. dev/QAS/PROD share one subaccount, so PROD
  # cannot create its own. The "proxy" plan points at the dev instance
  # and inherits its quota instead of consuming a new one.
  # NOTE: this means PROD reads the same credentials as dev.
  - name: sentinelgrc-credstore
    parameters:
      service-plan: proxy
      config:
        origin:
          serviceGuid: c17f47a4-ab67-4f5a-a01c-b872a41baa31
